# Servicio systemd para la API.
#
#   sudo cp deploy/perfiles-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now perfiles-api
#   sudo systemctl status perfiles-api
#
# Ajusta User, WorkingDirectory y la ruta de node si tu VPS difiere.

[Unit]
Description=API de perfiles editables
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/perfiles-api
ExecStart=/usr/bin/node src/server.js
EnvironmentFile=/var/www/perfiles-api/.env
Restart=always
RestartSec=5

# La API solo escucha en localhost: Nginx es quien la expone al exterior.
Environment=NODE_ENV=production

# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/perfiles-api

StandardOutput=journal
StandardError=journal
SyslogIdentifier=perfiles-api

[Install]
WantedBy=multi-user.target
