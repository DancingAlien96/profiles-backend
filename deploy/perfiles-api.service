# Servicio systemd para la API.
#
#   sudo cp deploy/perfiles-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now perfiles-api
#   sudo systemctl status perfiles-api
#
# Ajusta User, WorkingDirectory y la ruta de node si tu VPS difiere.

[Unit]
Description=API de perfiles editables
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/perfiles-api
ExecStart=/usr/bin/node src/server.js
EnvironmentFile=/var/www/perfiles-api/.env
Restart=always
RestartSec=5

Environment=NODE_ENV=production

# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# La base vive fuera del directorio del codigo para que un despliegue no la
# toque nunca. Este es el unico lugar donde el servicio puede escribir.
#   sudo mkdir -p /var/lib/perfiles-api
#   sudo chown deploy:deploy /var/lib/perfiles-api
#   sudo chmod 700 /var/lib/perfiles-api
# y en el .env:  DB_PATH=/var/lib/perfiles-api/perfiles.db
ReadWritePaths=/var/lib/perfiles-api

StandardOutput=journal
StandardError=journal
SyslogIdentifier=perfiles-api

[Install]
WantedBy=multi-user.target
