# ---- Base de datos ----
# Archivo SQLite. En el VPS conviene fuera del directorio del codigo, para que
# un despliegue no lo toque nunca: /var/lib/perfiles-api/perfiles.db
DB_PATH=./data/perfiles.db

# ---- Seguridad ----
# Secreto para firmar los tokens de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Clave maestra para crear/borrar perfiles (solo la usas tu, nunca el cliente)
ADMIN_KEY=cambia-esto-tambien

# ---- Frontend ----
# Dominios autorizados a consumir la API desde el navegador, separados por coma.
# En el VPS el sitio y la API comparten dominio detras de Nginx, asi que el
# panel usa rutas relativas y no pasa por CORS; la lista evita que cualquier
# otra pagina llame a la API desde el navegador de un visitante.
CORS_ORIGINS=http://localhost:4321,https://www.professionalprofiles.online

# Dominio del sitio. Con el se arman los enlaces de invitacion que imprime
# `npm run invitar` y las direcciones de vuelta del pago; si esta mal, le
# mandas al cliente un enlace que no abre.
SITE_URL=https://www.professionalprofiles.online

# ---- Recurrente (cobro de la suscripcion) ----
# Panel de Recurrente > Configuracion > Llaves API.
#
# Es la unica llave que pide la API, y ella sola decide el ambiente:
#   sk_test_...  sandbox, no mueve dinero real
#   sk_live_...  produccion, cobra de verdad
RECURRENTE_SECRET_KEY=sk_live_...

# Id del precio recurrente de $6.99 al mes. Se crea una sola vez con
# `npm run crear-precio` y se pega aqui.
RECURRENTE_PRICE_ID=price_...

# Clave de firma del endpoint de webhooks (empieza por whsec_).
# La da Svix al crear el endpoint, en el panel de Recurrente.
#
# OJO: es la del endpoint de ESTE sistema. La cuenta de la pasarela es
# compartida con el otro sistema del negocio y cada endpoint tiene la suya.
RECURRENTE_WEBHOOK_SECRET=whsec_...

# Dias que una tarjeta sigue viendose despues de que falle un cobro.
#
# No es generosidad: el cliente reparte tarjetas NFC y codigos QR impresos que
# no se pueden corregir. Que su tarjeta muera por una tarjeta de credito
# vencida, delante de un prospecto que la acaba de escanear, cuesta mas que los
# $6.99.
DIAS_DE_GRACIA=7

# ---- Avisos por correo (Resend) ----
# Opcional: sin estas variables todo funciona igual, solo que sin avisos.
#
# Se avisa cuando alguien paga por PRIMERA vez (hay que contactarlo para
# acordar el diseño de su tarjeta), cuando a alguien le falla el cobro (hay
# dias de gracia para llamarlo antes de que su tarjeta se apague) y cuando
# alguien se da de baja. Las renovaciones mensuales NO avisan: con varios
# clientes serian varios correos al mes sin nada que hacer en ninguno.
RESEND_API_KEY=re_...

# A donde llegan los avisos.
EMAIL_AVISOS=tucorreo@ejemplo.com

# Remitente. OJO: mientras no verifiques un dominio propio en Resend, el
# remitente de prueba onboarding@resend.dev SOLO puede escribirle a la
# direccion con la que abriste la cuenta de Resend. Para mandar a cualquier
# otra hay que verificar el dominio y usar algo como avisos@tudominio.com
EMAIL_FROM=Professional Profiles <onboarding@resend.dev>

# Codigo de pais para armar los enlaces de WhatsApp y telefono a partir de un
# numero local de 8 digitos.
CODIGO_PAIS=502

# Zona horaria del negocio. Decide cuando empieza un dia nuevo para el limite
# de cambios y el "abierto ahora" por defecto de los horarios.
ZONA_HORARIA=America/Guatemala

# Cambios que puede guardar cada cliente al dia. Publicar no cuesta nada, asi
# que es solo un freno ante un abuso o un fallo que guarde en bucle.
EDICIONES_POR_DIA=100

# Nginx hace de proxy hacia este puerto en localhost.
# Si lo cambias, ajusta tambien proxy_pass en deploy/nginx.conf.example.
PORT=5000
