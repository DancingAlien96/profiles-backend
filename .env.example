# ---- Base de datos ----
# Cluster de MongoDB Atlas. El /perfiles antes del ? es el nombre de la base:
# sin el, Mongoose se conectaria a una base llamada "test".
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/perfiles?retryWrites=true&w=majority

# ---- Seguridad ----
# Secreto para firmar los tokens de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Clave maestra para crear/borrar perfiles (solo la usas tu, nunca el cliente)
ADMIN_KEY=cambia-esto-tambien

# ---- Frontend ----
# Dominios autorizados a consumir la API, separados por coma.
# Debe incluir el dominio del sitio en Netlify o el navegador bloqueara las
# peticiones del panel de edicion por CORS.
CORS_ORIGINS=http://localhost:4321,https://tu-sitio.netlify.app

# Build hook de Netlify: al guardar un perfil se regenera el sitio estatico.
# Netlify > Site settings > Build & deploy > Build hooks > Add build hook
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxxxxxxx

# Segundos de espera antes de disparar el rebuild (agrupa ediciones seguidas)
REBUILD_DELAY_SECONDS=60

# Nginx hace de proxy hacia este puerto en localhost.
PORT=3000
