# ---- Base de datos ----
# Archivo SQLite. En el VPS conviene fuera del directorio del codigo, para que
# un despliegue no lo toque nunca: /var/lib/perfiles-api/perfiles.db
DB_PATH=./data/perfiles.db

# ---- Seguridad ----
# Secreto para firmar los tokens de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Clave maestra para crear/borrar perfiles (solo la usas tu, nunca el cliente)
ADMIN_KEY=cambia-esto-tambien

# ---- Frontend ----
# Dominios autorizados a consumir la API, separados por coma.
# Debe incluir el dominio del sitio en Netlify o el navegador bloqueara las
# peticiones del panel de edicion por CORS.
CORS_ORIGINS=http://localhost:4321,https://tu-sitio.netlify.app

# Build hook de Netlify: al guardar un perfil se regenera el sitio estatico.
# Netlify > Site settings > Build & deploy > Build hooks > Add build hook
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxxxxxxx

# Segundos de espera antes de disparar el rebuild. Agrupa varios guardados
# seguidos en un solo build; subirlo ahorra minutos de Netlify pero hace que
# los cambios tarden mas en verse.
REBUILD_DELAY_SECONDS=20

# Tope: si el primer cambio pendiente lleva esperando este tiempo, se publica
# aunque el cliente siga editando. Sin esto, quien guarde sin pausas veria su
# pagina congelada indefinidamente.
REBUILD_MAX_DELAY_SECONDS=120

# Codigo de pais para armar los enlaces de WhatsApp y telefono a partir de un
# numero local de 8 digitos.
CODIGO_PAIS=502

# Zona horaria del negocio. Decide cuando empieza un dia nuevo para el limite
# de cambios y el "abierto ahora" por defecto de los horarios.
ZONA_HORARIA=America/Guatemala

# Cambios que puede guardar cada cliente al dia. Cada uno dispara un build de
# Netlify, cuyos minutos son limitados.
EDICIONES_POR_DIA=20

# Nginx hace de proxy hacia este puerto en localhost.
# Si lo cambias, ajusta tambien proxy_pass en deploy/nginx.conf.example.
PORT=5000
